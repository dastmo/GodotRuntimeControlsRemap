; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

"Controls Remap/Remappable Actions"=[&"ui_up", &"ui_down", &"ui_left", &"ui_right"]
"Controls Remap/Events Dictionary"={
"Joypad Motion on Axis 1 (Left Stick Y-Axis, Joystick 0 Y-Axis) with Value -1.00": "Left Stick Up"
}
"Controls Remap/Action Names Dictionary"={
&"ui_down": "Drop Down"
}

[application]

config/name="Runtime Controls Remap"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

ControlsRemap="*uid://d252u3gj57frg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/runtime_controls_remap/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
